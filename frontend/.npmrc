# npm 10.9.4 (bundled with Node 22) crashes with
#   "Cannot read properties of null (reading 'edgesOut')"
# while resolving Nuxt's peer dependency graph -- a known arborist bug in
# build-ideal-tree.js #loadPeerSet. Skipping automatic peer resolution avoids it.
# Safe to remove once npm is upgraded past the fix.
legacy-peer-deps=true
